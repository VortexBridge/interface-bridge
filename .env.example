# ENDPOINTS
VITE_CHAIN=MAINNET
# Koinos node of the selected chain (MAINNET: api.koinos.io, TESTNET: harbinger-api.koinos.io); it needs transaction_store
VITE_KOINOS_RPC=https://api.koinos.io
VITE_ETH_RPC=https://ethereum-rpc.publicnode.com
VITE_BASE_RPC=https://mainnet.base.org
# Solana node for the Wormhole route (the default public one has little history; a history-capable one shows old transfers)
VITE_SOL_RPC=https://solana-rpc.publicnode.com
# Wormholescan API for the Wormhole routes
VITE_WORMHOLE_API=https://api.wormholescan.io
# Sepolia node (TESTNET builds only)
VITE_SEP_RPC=
# token list service (only used by the unused token-list client kept from v1)
VITE_TOKEN_API=https://tokens.koindx.com
# LAB builds only (lab/demo/config.cjs writes it): the lab chains' addresses as JSON
VITE_LAB_CONFIG=
# Vortex v2: the signing servers of the validators, comma separated. Every signature is checked in the browser against
# the validator set on the destination bridge, a wrong or hostile URL can only fail to help.
VITE_VORTEX_VALIDATORS=
# Collector profile: two HTTPS origins, primary first. Remove all validator URLs from this build.
# Direct mode is the compatibility default for existing installations.
VITE_VORTEX_COLLECTION_MODE=direct
VITE_VORTEX_COLLECTORS=
# Must exactly match the collector's configured deployment identifier (protocol version 1).
VITE_VORTEX_DEPLOYMENT=
